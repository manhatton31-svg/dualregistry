{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo 'paused: skip npm install'",
  "buildCommand": "mkdir -p .vercel-pause-out && cp public/paused.html .vercel-pause-out/index.html",
  "outputDirectory": ".vercel-pause-out",
  "framework": null,
  "git": {
    "deploymentEnabled": false
  },
  "fluid": false,
  "regions": ["iad1"],
  "crons": [],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
